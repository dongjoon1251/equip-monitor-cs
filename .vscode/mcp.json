{
  "inputs": [
    {
      "type": "promptString",
      "id": "equip-api-key",
      "description": "equip-monitor 조회 API 키 (EQUIP_API_KEY)",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "equip": {
      "type": "stdio",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/src/EquipMonitor.Mcp"],
      "env": {
        "EQUIP_API": "http://localhost:8000",
        "EQUIP_API_KEY": "${input:equip-api-key}"
      }
    }
  }
}
